{
  "name": "breadcrumb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Breadcrumb: a procedurally generated treasure-hunting simulation. Every discovery is a consequence of something that happened before you arrived.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "tsx scripts/validate.ts",
    "e2e": "tsx scripts/e2e.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
